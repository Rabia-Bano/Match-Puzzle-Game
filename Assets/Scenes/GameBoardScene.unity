  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - key: special_striped_h
    title: Striped Candy!
    message: 'Match 4 in a row to create this tile.

      Swap it to clear the entire
      row!'
    icon: {fileID: 21300000, guid: 010a36b7df74d4242a97ab51db32f7d5, type: 3}
  - key: special_striped_v
    title: Striped Candy!
    message: 'Match 4 in a column to create this tile.

      Swap it to clear the
      entire column!'
    icon: {fileID: 21300000, guid: 96f87aaf273961b4c8af224bf44bcdbc, type: 3}
  - key: special_wrapped
    title: Wrapped Tile!
    message: 'Match an L or T shape to create this tile.

      It blasts a 3x3 area!'
    icon: {fileID: 21300000, guid: 149adbdb5128c1b4daec0cc51f33f7c2, type: 3}
  - key: special_colorbomb
    title: Color Bomb!
    message: 'Match 5 tiles in a line.

      Swap it with any tile to clear every
      tile of that color!'
    icon: {fileID: 21300000, guid: 705e9940d29188e439eb700a0f4f1872, type: 3}
  - key: obstacle_jelly
    title: Chain
    message: Match tiles on top of Chain to clear it. Clearing all the Chain is required
      to win this level!
    icon: {fileID: -8566028455312386561, guid: 70a4b60b447a62848a34d3e6223cecb6, type: 3}
  - key: obstacle_hardtile
    title: Blocker Tile!
    message: This tile can't be matched or swapped. Hit it directly with a Striped
      or Wrapped Bomb blast to break it.
    icon: {fileID: 5433810254438387866, guid: 291958c3243d200469dca7e7357b3576, type: 3}
  - key: obstacle_stone
    title: Ingredient!
    message: 'This stone falls with gravity but can''t be matched.

      Get it
      all the way to the bottom row to collect it.'
    icon: {fileID: -6471164996032937220, guid: 446ae90fc19ca67458124a655e811efe, type: 3}
