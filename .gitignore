# ============================================================
#  .gitignore — Unity Projects
#  Ye file bilkul apne project ke ROOT folder mein rakhni hai
#  (jahan "Assets", "Packages", "ProjectSettings" folders hain)
# ============================================================

# Unity generated folders — inhe kabhi commit nahi karna
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Auto-generated meta backups
*.tmp
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Visual Studio / Rider / VS Code cache
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D Asset Store generated
/[Aa]ssets/AssetStoreTools*

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.apk
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packages lock file (usually fine to keep, uncomment to ignore)
# /Packages/packages-lock.json

# Firebase — NEVER commit real API keys / google-services files
/Assets/StreamingAssets/google-services-desktop.json
/Assets/Firebase/Editor/AppOptions.cs

# OS files
.DS_Store
Thumbs.db
# Android / Unity temporary build folder
.utmp/

# Gradle
.gradle/

# Android Studio
.local.properties

/Assets/Firebase/Plugins/